{
  "name": "fittracker-pro",
  "version": "1.0.6",
  "description": "FitTracker Pro Local Dev Server",
  "scripts": {
    "dev": "npx -y serve -l 3000 .",
    "build:android:aab": "cd android_app && ./gradlew bundleRelease",
    "build:android:apk": "cd android_app && ./gradlew assembleRelease",
    "deploy:android:internal": "cd android_app && fastlane internal",
    "deploy:android:production": "cd android_app && fastlane production"
  },
  "devDependencies": {
    "wrangler": "^4.115.0"
  }
}
